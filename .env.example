# Production domain, once confirmed. Falls back to the current verified domain if unset.
NEXT_PUBLIC_SITE_URL=https://www.economycodes.com

# Contact form delivery via Resend (https://resend.com). Without both
# RESEND_API_KEY and CONTACT_FORM_TO_EMAIL, submissions are only logged in
# development and fail with a visible error in production.
# RESEND_API_KEY=
# CONTACT_FORM_TO_EMAIL=info@economycodes.com
# Sender address -- must be on a domain verified in Resend.
# CONTACT_FORM_FROM_EMAIL="Economy Codes <kontakt@economycodes.com>"

# Admin dashboard (/admin). Without DATABASE_URL the site serves the built-in
# content/ data and the dashboard shows a setup notice.
# Neon Postgres connection string (pooled), then: npm run db:migrate && npm run cms:seed
# DATABASE_URL=
# Vercel Blob read/write token, for image uploads in the media library.
# BLOB_READ_WRITE_TOKEN=
# Dashboard password, and a random secret of 32+ characters for signing the
# session cookie (e.g. `openssl rand -base64 48`).
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
